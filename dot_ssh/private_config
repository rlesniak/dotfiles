# SSH config managed by chezmoi.
# SSH private keys are restored by chezmoi from age-encrypted source files.
# Note: OrbStack adds its own Include block automatically after installation.
# VPS-specific hosts (IPs) are not tracked here — add them manually per machine.

# Primary GitHub Account
Host personal
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_personal
    IdentitiesOnly yes

# Secondary GitHub Account
Host secondary
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_secondary
    IdentitiesOnly yes

# GitHub via port 443 (if port 22 is blocked)
Host github.com
    HostName ssh.github.com
    Port 443
    User git
    IdentityFile ~/.ssh/id_personal
    IdentitiesOnly yes
